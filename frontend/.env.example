# Optional server-side document model
DOC_MODEL_URL=
DOC_MODEL_AUTH=
USE_MOCK_MODEL=true

# Optional server-side email/AI/payment integrations
RESEND_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
