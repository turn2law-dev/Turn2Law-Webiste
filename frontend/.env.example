# ─────────────────────────────────────────────────────────────────────────────
# Turn2Law — Environment Variables Reference
# Copy to .env.local for local development.
# Configure real values in Vercel Project → Settings → Environment Variables.
# NEVER commit .env.local or real secret values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public — safe for browser) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Backend API (Node.js Express — separate service) ────────────────────────
# Local:      http://localhost:3001
# Production: https://your-backend.railway.app  (or Render / Fly.io / etc.)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LAWGPT_API_URL=http://localhost:3001

# ── Document Generation Engine (Python FastAPI — separate service) ──────────
# Local:      http://127.0.0.1:8000
# Production: https://your-docengine.railway.app  (or Render / Fly.io / etc.)
#             The FastAPI server from backend/docs/documentGeneration-master/
# IMPORTANT:  Must be a publicly reachable HTTPS URL in production on Vercel.
DOCUMENT_GENERATION_API_URL=http://127.0.0.1:8000

# ── Gemini AI (Google Generative AI via Genkit) — SERVER SIDE ONLY ──────────
# Get your key at: https://aistudio.google.com/app/apikey
# DO NOT use NEXT_PUBLIC_ prefix — this must never reach the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── AI / LLM alternatives (optional) ────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Document model override (optional — leave blank to use mock renderer) ───
DOC_MODEL_URL=
DOC_MODEL_AUTH=
USE_MOCK_MODEL=true

# ── Payments (Paytm) — optional ──────────────────────────────────────────────
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
